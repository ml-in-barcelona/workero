# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "OCaml hello world compiled to JS and WasmGC for Cloudflare Workers"
depends: [
  "ocaml" {>= "5.5"}
  "dune" {>= "3.24"}
  "js_of_ocaml"
  "js_of_ocaml-ppx"
  "wasm_of_ocaml-compiler"
  "ocamlformat" {with-dev-setup}
  "ocaml-lsp-server" {with-dev-setup}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
