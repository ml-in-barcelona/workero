let page =
  <Components.Layout title="workero + React">
    <Components.Hero />
    <Components.Source file="main.mlx" code=Source.main />
    <Components.Source file="components.mlx" code=Source.components />
  </Components.Layout>

let handler req _env _ctx =
  let open Workero in
  match (Request.method_ req, URL.path (Request.url req)) with
  | GET, "/" -> Response.html (React_dom.render_to_string page)
  | _ -> Response.text ~status:404 "not found\n"

let () = Workero.serve handler
