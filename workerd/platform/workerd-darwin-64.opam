opam-version: "2.0"
version: "1.20261019.1"
synopsis: "The workerd binary for macOS x86_64"
description:
  "The prebuilt workerd binary from Cloudflare for macOS x86_64. Install the workerd package instead; it selects this one."
license: "Apache-2.0"
homepage: "https://github.com/cloudflare/workerd"
maintainer: ["David Sancho <dsnxmoreno@gmail.com>"]
authors: ["Cloudflare, Inc."]
bug-reports: "https://github.com/ml-in-barcelona/workero/issues"
dev-repo: "git+https://github.com/ml-in-barcelona/workero.git"
x-maintenance-intent: ["(latest)"]
available: os = "macos" & arch = "x86_64"
install: [
  ["install" "-m" "755" "bin/workerd" "%{bin}%/workerd"]
]
url {
  src: "https://registry.npmjs.org/@cloudflare/workerd-darwin-64/-/workerd-darwin-64-1.20261019.1.tgz"
  checksum: "sha512=e5920b6c0b5afdf050be198061e084edd28c31822becdf702445f9d1f1062ca488c06b6f4f41f349f1cd20afceedc050e201d0d967c888f0a5bf07327ba1347c"
}
