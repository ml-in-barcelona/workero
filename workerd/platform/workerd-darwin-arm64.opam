opam-version: "2.0"
version: "1.20261019.1"
synopsis: "The workerd binary for macOS arm64"
description:
  "The prebuilt workerd binary from Cloudflare for macOS arm64. Install the workerd package instead; it selects this one."
license: "Apache-2.0"
homepage: "https://github.com/cloudflare/workerd"
maintainer: ["David Sancho <dsnxmoreno@gmail.com>"]
authors: ["Cloudflare, Inc."]
bug-reports: "https://github.com/ml-in-barcelona/workero/issues"
dev-repo: "git+https://github.com/ml-in-barcelona/workero.git"
x-maintenance-intent: ["(latest)"]
available: os = "macos" & arch = "arm64"
install: [
  ["install" "-m" "755" "bin/workerd" "%{bin}%/workerd"]
]
url {
  src: "https://registry.npmjs.org/@cloudflare/workerd-darwin-arm64/-/workerd-darwin-arm64-1.20261019.1.tgz"
  checksum: "sha512=730c3601bea554cc694e21048ca98f239f29e44328d2f6136521fedd692a5c975081cdc44bae86b8bdb8efe5360766166a3861bb6b6a8fb8f24ab5e7794ef8f6"
}
