(executable
 (name main)
 (public_name workero)
 (package workero)
 (libraries unix str))

(rule
 (targets embedded.ml)
 (deps load-wasm.js index.js durable-object.js entrypoint.js workflow.js)
 (action
  (with-stdout-to
   embedded.ml
   (progn
    (echo "let load_wasm = {js|")
    (cat load-wasm.js)
    (echo "|js}\nlet index = {js|")
    (cat index.js)
    (echo "|js}\nlet durable_object = {js|")
    (cat durable-object.js)
    (echo "|js}\nlet entrypoint = {js|")
    (cat entrypoint.js)
    (echo "|js}\nlet workflow = {js|")
    (cat workflow.js)
    (echo "|js}\n")))))
