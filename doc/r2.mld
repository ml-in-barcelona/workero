{0 R2}

{!Workero.R2} is a
{{:https://developers.cloudflare.com/r2/}Cloudflare R2} bucket: object storage
for large files. An object is raw bytes held in an OCaml [string].

{1 Configure}

{@sh[
npx wrangler r2 bucket create my-bucket
]}

{@toml[
[[r2_buckets]]
binding = "BUCKET"
bucket_name = "my-bucket"
]}

{1 Use}

{@ocaml[
let handler req env _ctx =
  let open Workero in
  let bucket = R2.of_env env "BUCKET" in
  let key = URL.path (Request.url req) in
  match Request.method_ req with
  | PUT ->
      let content_type = Request.header req "content-type" in
      R2.put ?content_type bucket key (Request.body_bytes req);
      Response.text ~status:201 "stored\n"
  | GET -> (
      match (R2.head bucket key, R2.get bucket key) with
      | Some { content_type; _ }, Some bytes ->
          let headers =
            match content_type with
            | Some ct -> [ ("content-type", ct) ]
            | None -> []
          in
          Response.bytes ~headers bytes
      | _ -> Response.text ~status:404 "not found\n")
  | DELETE ->
      R2.delete bucket key;
      Response.text "deleted\n"
  | _ -> Response.text ~status:405 "method not allowed\n"

let () = Workero.serve handler
]}

- {!Workero.R2.of_env} opens the bucket bound as ["BUCKET"]. It raises
  [Invalid_argument] when there is no such binding.
- {!Workero.R2.get} gives the bytes, or [None] when the key does not exist.
- {!Workero.R2.put} stores bytes under a key and replaces any object.
  [~content_type] is kept as the [Content-Type] of the object.
- {!Workero.R2.head} gives the metadata without the body: [size], [etag] and
  [content_type]. It gives [None] for a missing key.
- {!Workero.R2.delete} removes an object. A missing key is not an error.

{!Workero.R2.get} reads the whole object into memory. Keep large objects within
the memory limit of the Worker.

{1 Test locally}

{@sh[
npx wrangler dev
curl -X PUT -H "content-type: text/plain" -d hello localhost:8787/notes.txt
curl localhost:8787/notes.txt
]}
