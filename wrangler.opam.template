version: "4.151.3"
available: [ (os = "linux" | os = "macos") & (arch = "x86_64" | arch = "arm64") ]
depends: [
  "conf-npm"
  "workerd" {= "1.20261019.1"}
]
build: [
  ["node" "-e" "if (parseInt(process.versions.node) < 22) { console.error(\"wrangler needs Node.js 22 or later\"); process.exit(1); }"]
]
install: [
  ["mkdir" "-p" "%{lib}%/wrangler"]
  ["cp" "-R" "node_modules" "%{lib}%/wrangler/"]
  ["sh" "-c" "mkdir -p \"$0/bin\" && ln -sf \"$1\" \"$0/bin/workerd\"" "%{lib}%/wrangler/node_modules/@cloudflare/workerd-linux-64" "%{bin}%/workerd"] {os = "linux" & arch = "x86_64"}
  ["sh" "-c" "mkdir -p \"$0/bin\" && ln -sf \"$1\" \"$0/bin/workerd\"" "%{lib}%/wrangler/node_modules/@cloudflare/workerd-linux-arm64" "%{bin}%/workerd"] {os = "linux" & arch = "arm64"}
  ["sh" "-c" "mkdir -p \"$0/bin\" && ln -sf \"$1\" \"$0/bin/workerd\"" "%{lib}%/wrangler/node_modules/@cloudflare/workerd-darwin-64" "%{bin}%/workerd"] {os = "macos" & arch = "x86_64"}
  ["sh" "-c" "mkdir -p \"$0/bin\" && ln -sf \"$1\" \"$0/bin/workerd\"" "%{lib}%/wrangler/node_modules/@cloudflare/workerd-darwin-arm64" "%{bin}%/workerd"] {os = "macos" & arch = "arm64"}
  ["ln" "-sf" "../lib/wrangler/node_modules/wrangler/bin/wrangler.js" "%{bin}%/wrangler"]
]
